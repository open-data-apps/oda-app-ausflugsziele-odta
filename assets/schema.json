{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "oda-app-ausflugsziele",
  "title": "Ausflugsziele",
  "fields": [
    {
      "name": "identifier",
      "title": "Kennung",
      "type": "string",
      "description": "Eindeutige UUID des Eintrags.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "@type",
      "title": "Typ",
      "type": "string",
      "description": "schema.org-Typ, hier Place.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "name",
      "title": "Name",
      "type": "object",
      "description": "Name als Sprach-Map (de/en); die App wählt nach Standardsprache.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "disambiguatingDescription",
      "title": "Kurzprofil",
      "type": "object",
      "description": "Kurzbeschreibung als Sprach-Map (de/en).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "description",
      "title": "Beschreibung",
      "type": "object",
      "description": "Beschreibung als Sprach-Map (de/en).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.addressLocality",
      "title": "Ort",
      "type": "string",
      "description": "Ortsname der Adresse.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.postalCode",
      "title": "PLZ",
      "type": "string",
      "description": "Postleitzahl als Text.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.streetAddress",
      "title": "Straße",
      "type": "string",
      "description": "Straße und Hausnummer.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.addressCountry.name",
      "title": "Land",
      "type": "string",
      "description": "Länderkürzel aus dem Country-Objekt.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.telephone",
      "title": "Telefon",
      "type": "string",
      "description": "Telefonnummer als Text.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.url",
      "title": "Webseite",
      "type": "string",
      "description": "Webseite des Eintrags als URL-Text.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "address.email",
      "title": "E-Mail",
      "type": "string",
      "description": "E-Mail-Adresse als Text.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "geo.latitude",
      "title": "Breite",
      "type": "string",
      "description": "Breitengrad als Text geliefert; die App wandelt mit Number() um.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "geo.longitude",
      "title": "Länge",
      "type": "string",
      "description": "Längengrad als Text geliefert; die App wandelt mit Number() um.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "geo.altitude",
      "title": "Höhe",
      "type": "number",
      "description": "Höhenangabe, falls geliefert.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "image",
      "title": "Bilder",
      "type": "array",
      "description": "Liste von Bild-Objekten mit contentUrl.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "license",
      "title": "Lizenz",
      "type": "string",
      "description": "Lizenz des Eintrags, z. B. CC0.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "copyrightHolder",
      "title": "Rechteinhaber",
      "type": "string",
      "description": "Rechteinhaber der Daten.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "dateModified",
      "title": "Geändert am",
      "type": "datetime",
      "description": "Zeitpunkt der letzten Änderung (ISO-8601).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "openingHours",
      "title": "Öffnungszeiten",
      "type": "object",
      "description": "Öffnungszeiten als Sprach-Map.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "openingHoursSpecification",
      "title": "Öffnungszeiten-Regeln",
      "type": "object",
      "description": "Strukturierte Öffnungszeiten, falls geliefert.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "amenityFeature",
      "title": "Ausstattung",
      "type": "array",
      "description": "Liste von Ausstattungsmerkmalen, falls geliefert.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "additionalProperty",
      "title": "Zusatzdaten",
      "type": "object",
      "description": "Zusätzliche Eigenschaften, z. B. openstreetmap_id.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "isAccessibleForFree",
      "title": "Kostenlos zugänglich",
      "type": "boolean",
      "description": "Freier Zugang, falls Angabe vorhanden.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "priceRange",
      "title": "Preislage",
      "type": "array",
      "description": "Preislage als Liste, z. B. [„moderate“].",
      "constraints": {
        "required": false
      }
    }
  ]
}
